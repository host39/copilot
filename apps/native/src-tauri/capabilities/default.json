{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: API calls through the HTTP plugin to any server the user connects to, links opened in the system browser, and Android's back button.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:app:allow-exit",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "mailto:*" }]
    }
  ]
}
