# App
ENVIRONMENT=local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# CORS_ALLOWED_ORIGINS=app.example.com,.example.org

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot
DB_USER=postgres
DB_PASSWORD=postgres
DB_READONLY_USER=readonly
DB_READONLY_PASSWORD=readonly
# migrate only: create the server's role copilot_server (then run the server with DB_USER=copilot_server)
# DB_SERVER_PASSWORD=
# DB_SSL=false
# DB_SSL_ROOT_CERT=/path/to/ca-bundle.pem

# Copilot
# Seals provider keys and tool server headers: 32 random bytes in base64
# (`openssl rand -base64 32`). Required. `make setup` (scripts/env-local.sh) fills in a generated
# one when this is blank. Changing it makes every stored key unreadable.
SECRET_KEY=
# Whose connections may reach private and loopback addresses: none, admins, or all.
ALLOW_PRIVATE_NETWORK=admins
MAX_UPLOAD_MB=25
MAX_STORAGE_MB_PER_USER=1024
# The built web bundle to serve (`pnpm --filter @copilot/web build` writes apps/web/dist).
# WEB_DIR=apps/web/dist

# Identity (lib-rustauth)
# Allow sign-ups after the first (administrator) account.
AUTH_REGISTRATION_OPEN=true
# Token for the first registration (16 or more characters). Unset: a random one is logged once.
# AUTH_SETUP_TOKEN=
# AUTH_SESSION_TTL_DAYS=30
# AUTH_SESSION_MAX_DAYS=90
# Comma-separated IPs or CIDRs whose X-Forwarded-For is trusted (your reverse proxy).
# AUTH_TRUSTED_PROXIES=
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_LOCKOUT_MAX_MINUTES=1440
# AUTH_IP_FAILURE_LIMIT=30
# AUTH_RATE_LIMIT_PER_MINUTE=60
