meta {
  name: 00-01 Ready
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq healthy
  res.body.database: eq up
}

docs {
  **Endpoint:** `GET /health/ready`

  **This test verifies:** the API reaches Postgres (run `make setup` first).
}
