meta {
  name: 02-05 Login
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.token);
  }
}

assert {
  res.status: eq 200
  res.body.data.token: isString
  res.body.data.user.id: eq {{userId}}
}

docs {
  **Endpoint:** `POST /api/auth/login` (public)

  **This test verifies:** the new account signs in; the session token is stored as `token` for
  later folders.
}
