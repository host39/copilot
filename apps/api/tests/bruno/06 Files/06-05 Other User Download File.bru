meta {
  name: 06-05 Other User Download File
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/files/{{fileId}}/content
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/files/{id}/content` as user B

  **This test verifies:** user B never reads user A's bytes.
}
