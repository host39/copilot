meta {
  name: 06-00 Upload Project File
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/projects/{{projectId}}/files
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file(fixtures/notes.txt)
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("fileId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.name: eq notes.txt
  res.body.data.mediaType: eq text/plain
  res.body.data.projectId: eq {{projectId}}
  res.body.data.chatId: isNull
  res.body.data.sizeBytes: gt 0
  res.body.data.included: eq true
}

docs {
  **Endpoint:** `POST /api/projects/{id}/files` (multipart, one part named `file`)

  **This test verifies:** a text file is stored as an included project file with its checked
  type; its id is stored as `fileId`.
}
