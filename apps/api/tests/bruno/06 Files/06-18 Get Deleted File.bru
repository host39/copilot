meta {
  name: 06-18 Get Deleted File
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/files/{{fileId}}/content
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/files/{id}/content`

  **This test verifies:** a deleted file is gone with its bytes.
}
