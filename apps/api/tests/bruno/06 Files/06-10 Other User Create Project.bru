meta {
  name: 06-10 Other User Create Project
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

body:json {
  {
    "name": "Bruno B Project"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("otherProjectId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
}

docs {
  **Endpoint:** `POST /api/projects` as user B

  **This test verifies:** user B creates a project of their own (`otherProjectId`) for the
  checks of ids in bodies.
}
