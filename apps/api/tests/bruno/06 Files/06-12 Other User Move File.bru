meta {
  name: 06-12 Other User Move File
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/files/{{fileId}}/move
  body: json
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

body:json {
  {
    "projectId": "{{otherProjectId}}"
  }
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `POST /api/files/{id}/move` as user B

  **This test verifies:** user B cannot take user A's file into their own project.
}
