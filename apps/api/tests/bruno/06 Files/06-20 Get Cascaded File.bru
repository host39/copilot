meta {
  name: 06-20 Get Cascaded File
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/files/{{attachmentId}}/content
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/files/{id}/content`

  **This test verifies:** the moved attachment went with its project.
}
