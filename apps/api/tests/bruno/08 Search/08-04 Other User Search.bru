meta {
  name: 08-04 Other User Search
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/search?q=searchable
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

tests {
  test("never finds user A's chat", function () {
    const ids = res.body.items.map((hit) => hit.chatId);
    expect(ids).to.not.include(bru.getVar("searchChatId"));
  });
}

docs {
  **Endpoint:** `GET /api/search?q=searchable` as user B

  **This test verifies:** user B never finds user A's chat.
}
