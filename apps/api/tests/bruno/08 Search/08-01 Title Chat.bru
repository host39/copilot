meta {
  name: 08-01 Title Chat
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/chats/{{searchChatId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Bruno searchable ownership notes"
  }
}

assert {
  res.status: eq 200
  res.body.data.title: eq "Bruno searchable ownership notes"
}

docs {
  **Endpoint:** `PATCH /api/chats/{id}`

  **This test verifies:** the chat gets a title with the words to find.
}
