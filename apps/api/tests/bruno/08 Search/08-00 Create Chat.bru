meta {
  name: 08-00 Create Chat
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/chats
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {}
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("searchChatId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
}

docs {
  **Endpoint:** `POST /api/chats`

  **This test verifies:** a chat to search for (`searchChatId`).
}
