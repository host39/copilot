meta {
  name: 04-07 Other User Provider Models
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/providers/{{providerId}}/models
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/providers/{id}/models` as user B

  **This test verifies:** user B cannot list the models of user A's connection.
}
