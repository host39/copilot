meta {
  name: 04-03 Update Provider
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/providers/{{providerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Renamed",
    "baseUrl": "https://other.example.com/v1"
  }
}

assert {
  res.status: eq 200
  res.body.data.name: eq "Bruno Renamed"
  res.body.data.baseUrl: eq "https://other.example.com/v1"
  res.body.data.key: eq missing
}

docs {
  **Endpoint:** `PATCH /api/providers/{id}`

  **This test verifies:** a base URL with another origin clears the stored key, so the key never
  goes to a host it was not entered for.
}
