meta {
  name: 04-04 Other User Get Provider
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/providers/{{providerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/providers/{id}` as user B

  **This test verifies:** user B gets `404` for user A's connection, never `403`.
}
