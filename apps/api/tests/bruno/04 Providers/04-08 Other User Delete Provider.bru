meta {
  name: 04-08 Other User Delete Provider
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/providers/{{providerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `DELETE /api/providers/{id}` as user B

  **This test verifies:** user B cannot delete user A's connection.
}
