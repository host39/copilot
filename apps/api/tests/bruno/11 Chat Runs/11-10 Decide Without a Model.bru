meta {
  name: 11-10 Decide Without a Model
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/chats/{{runChatId}}/messages/00000000-0000-7000-8000-000000000000/decisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "decisions": [
      { "callId": "00000000-0000-7000-8000-000000000000", "decision": "approve" }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_ERROR
}

docs {
  **Endpoint:** `POST /api/chats/{id}/messages/{messageId}/decisions`

  **This test verifies:** a chat without a model cannot continue a turn: a `400` before any
  stream, and the chat is not left busy.
}
