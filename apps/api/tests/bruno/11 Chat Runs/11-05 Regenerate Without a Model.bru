meta {
  name: 11-05 Regenerate Without a Model
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/chats/{{runChatId}}/regenerate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_ERROR
}

docs {
  **Endpoint:** `POST /api/chats/{id}/regenerate`

  **This test verifies:** a chat without a model cannot answer: a `400` before any stream, and
  the chat is not left busy.
}
