meta {
  name: 11-03 Stream Invalid After
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/chats/{{runChatId}}/stream?after=soon
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_ERROR
}

docs {
  **Endpoint:** `GET /api/chats/{id}/stream?after=soon`

  **This test verifies:** `after` must be a number.
}
