meta {
  name: 11-06 Other User Stream
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/chats/{{runChatId}}/stream
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/chats/{id}/stream` as user B

  **This test verifies:** user B gets `404` for user A's chat and never attaches to its run.
}
