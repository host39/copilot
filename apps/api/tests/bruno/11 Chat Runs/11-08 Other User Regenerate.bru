meta {
  name: 11-08 Other User Regenerate
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/chats/{{runChatId}}/regenerate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `POST /api/chats/{id}/regenerate` as user B

  **This test verifies:** user B gets `404` for user A's chat, never `CHAT_BUSY`.
}
