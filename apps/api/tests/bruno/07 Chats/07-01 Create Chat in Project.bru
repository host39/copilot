meta {
  name: 07-01 Create Chat in Project
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/chats
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "projectId": "{{chatProjectId}}",
    "instructions": "Bruno secret plan.",
    "reasoning": "low"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("chatId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.projectId: eq {{chatProjectId}}
  res.body.data.title: isEmpty
  res.body.data.instructions: eq "Bruno secret plan."
  res.body.data.reasoning: eq low
  res.body.data.pinned: eq false
}

docs {
  **Endpoint:** `POST /api/chats`

  **This test verifies:** a chat in the project with its own instructions; its id replaces
  `chatId` (from `06 Files`).
}
