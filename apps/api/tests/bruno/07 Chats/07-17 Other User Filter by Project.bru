meta {
  name: 07-17 Other User Filter by Project
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/chats?projectId={{chatProjectId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/chats?projectId={id}` as user B, with user A's project

  **This test verifies:** user A's project id in a query is a `404`, not an empty list.
}
