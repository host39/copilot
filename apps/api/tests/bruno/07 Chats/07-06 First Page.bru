meta {
  name: 07-06 First Page
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/chats?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("chatCursor", res.body.next);
  }
}

assert {
  res.status: eq 200
  res.body.items[0].id: eq {{standaloneChatId}}
  res.body.next: isString
}

docs {
  **Endpoint:** `GET /api/chats?limit=1`

  **This test verifies:** the newest chat comes first and a full page carries the `next` cursor
  (`chatCursor`).
}
