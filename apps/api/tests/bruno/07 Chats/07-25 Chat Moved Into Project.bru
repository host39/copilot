meta {
  name: 07-25 Chat Moved Into Project
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/chats/{{standaloneChatId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.projectId: eq {{savedProjectId}}
  res.body.data.instructions: isEmpty
}

docs {
  **Endpoint:** `GET /api/chats/{id}`

  **This test verifies:** the chat moved into the new project and kept no instructions.
}
