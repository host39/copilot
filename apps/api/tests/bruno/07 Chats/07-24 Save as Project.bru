meta {
  name: 07-24 Save as Project
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/chats/{{standaloneChatId}}/save-as-project
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("savedProjectId", res.body.data.id);
  }
}

assert {
  res.status: eq 200
  res.body.data.name: eq "New project"
  res.body.data.instructions: eq "Standalone notes."
}

docs {
  **Endpoint:** `POST /api/chats/{id}/save-as-project`

  **This test verifies:** an untitled standalone chat becomes a project with its instructions
  (`savedProjectId`).
}
