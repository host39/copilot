meta {
  name: 05-08 Other User List Projects
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/projects
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 200
  res.body.total: eq 0
}

docs {
  **Endpoint:** `GET /api/projects` as user B

  **This test verifies:** user B's list never holds user A's project.
}
