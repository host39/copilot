meta {
  name: 05-00 Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "  Bruno Research  ",
    "icon": "🔬",
    "instructions": "Cite sources.",
    "reasoning": "low",
    "builtinTools": ["schedules"],
    "pinned": true
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("projectId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isString
  res.body.data.name: eq "Bruno Research"
  res.body.data.icon: eq 🔬
  res.body.data.reasoning: eq low
  res.body.data.builtinTools[0]: eq schedules
  res.body.data.toolServerIds: isEmpty
  res.body.data.defaultModelId: isNull
  res.body.data.pinned: eq true
}

docs {
  **Endpoint:** `POST /api/projects`

  **This test verifies:** a project is created with its settings (the name trimmed); its id is
  stored as `projectId`.
}
