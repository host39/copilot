meta {
  name: 05-11 Create Project to Delete
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Doomed"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("doomedProjectId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.pinned: eq false
}

docs {
  **Endpoint:** `POST /api/projects`

  **This test verifies:** a project with a name only gets the defaults; its id is stored as
  `doomedProjectId`.
}
