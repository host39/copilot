meta {
  name: 05-06 Other User Delete Project
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/projects/{{projectId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `DELETE /api/projects/{id}` as user B

  **This test verifies:** user B cannot delete user A's project.
}
