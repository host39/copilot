meta {
  name: 05-09 Unknown Tool Server
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Borrowed",
    "toolServerIds": ["00000000-0000-7000-8000-000000000000"]
  }
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `POST /api/projects`

  **This test verifies:** a tool server id the caller does not own is `404`, and no project is
  created with it.
}
