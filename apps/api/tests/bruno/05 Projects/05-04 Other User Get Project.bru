meta {
  name: 05-04 Other User Get Project
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/projects/{{projectId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `GET /api/projects/{id}` as user B

  **This test verifies:** user B gets `404` for user A's project, never its instructions.
}
