meta {
  name: 05-10 Invalid Query
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/projects?limit=lots
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_ERROR
}

docs {
  **Endpoint:** `GET /api/projects?limit=lots`

  **This test verifies:** a query parameter that does not fit is a `400` with the error body.
}
