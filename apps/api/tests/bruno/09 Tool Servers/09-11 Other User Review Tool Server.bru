meta {
  name: 09-11 Other User Review Tool Server
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/tool-servers/{{toolServerId}}/review
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `POST /api/tool-servers/{id}/review` as user B

  **This test verifies:** user B cannot accept user A's tool list.
}
