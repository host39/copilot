meta {
  name: 09-12 Other User Delete Tool Server
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/api/tool-servers/{{toolServerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq ENTITY_NOT_FOUND
}

docs {
  **Endpoint:** `DELETE /api/tool-servers/{id}` as user B

  **This test verifies:** user B cannot delete user A's server.
}
