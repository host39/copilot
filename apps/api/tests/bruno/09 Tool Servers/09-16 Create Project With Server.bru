meta {
  name: 09-16 Create Project With Server
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Tools",
    "toolServerIds": ["{{toolServerId}}"]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("toolProjectId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.toolServerIds[0]: eq {{toolServerId}}
}

docs {
  **Endpoint:** `POST /api/projects`

  **This test verifies:** the owner enables the server in a project (`toolProjectId`).
}
