meta {
  name: 09-07 Test Unreachable Server
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/tool-servers/{{toolServerId}}/test
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 502
  res.body.code: eq TOOL_SERVER_UNREACHABLE
  res.body.error: eq "Could not connect to the tool server. Check its URL."
}

docs {
  **Endpoint:** `POST /api/tool-servers/{id}/test`

  **This test verifies:** a test that cannot reach the server is a `502` with the MCP adapter's code
  and a readable message (`.invalid` hosts never resolve).
}
