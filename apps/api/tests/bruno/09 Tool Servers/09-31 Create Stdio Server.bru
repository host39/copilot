meta {
  name: 09-31 Create Stdio Server
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/tool-servers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno stdio",
    "transport": "stdio",
    "stdio": {
      "command": "/nonexistent/bruno-mcp",
      "args": ["--root", "/srv/data dir"],
      "env": { "API_KEY": "bruno-secret-env" }
    }
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("stdioServerId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.transport: eq stdio
  res.body.data.url: isNull
  res.body.data.authMode: eq none
  res.body.data.stdio.command: eq /nonexistent/bruno-mcp
  res.body.data.stdio.env: eq set
  res.body.data.reviewRequired: eq false
}

tests {
  test("shows the whole program and the variable names, never a value", function () {
    expect(res.body.data.stdio.args).to.eql(["--root", "/srv/data dir"]);
    expect(res.body.data.stdio.envNames).to.eql(["API_KEY"]);
    expect(res.body.data.stdio.cwd).to.equal(res.body.data.id);
    expect(JSON.stringify(res.body)).to.not.include("bruno-secret");
  });
}

docs {
  **Endpoint:** `POST /api/tool-servers` with `transport: stdio`

  **This test verifies:** an administrator adds a stdio server; the response shows the command and every argument as entered, the names of its environment variables but not their values, and its own working directory.
}
