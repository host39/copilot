# The web client calls the server that served it (`/api`); in development the dev server
# proxies `/api` and `/health` to the API. See docs/env.md.

# Where the dev server proxies `/api` and `/health` (default http://localhost:3000).
# API_PROXY_TARGET=http://localhost:3001

# Call another server directly instead (it must allow this origin in CORS_ALLOWED_ORIGINS).
# The client then requests <PUBLIC_API_URL>/api/... and <PUBLIC_API_URL>/health.
# PUBLIC_API_URL=http://localhost:3001
